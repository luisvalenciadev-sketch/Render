# Copia este archivo a ".env" y rellena tus valores reales.
# NO subas ".env" a control de versiones.

PORT=3000
NODE_ENV=development

# --- Telegram ---
# Genera un token nuevo con @BotFather (/newbot o /revoke) y pégalo aquí.
# NUNCA lo pongas en el frontend ni lo compartas en chats.
TELEGRAM_BOT_TOKEN=pon-aqui-tu-token-nuevo

# ID del chat/grupo de operadores (ej: -100xxxxxxxxxx para supergrupos).
TELEGRAM_OPERATORS_CHAT_ID=-5386557685

# Minutos que espera una solicitud antes de expirar.
REQUEST_TTL_MIN=5
